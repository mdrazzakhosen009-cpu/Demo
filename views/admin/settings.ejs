<%- include('_shell_start') %>
<h1 class="serif" style="font-size:42px">Store Settings</h1><p style="color:#777">All settings below are saved in Turso and reflected on the public website. The official LLP circular logo is fixed and cannot be changed.</p>
<% if(message){%><div class="notice"><%= message %></div><%}%><% if(error){%><div class="notice"><%= error %></div><%}%>
<form class="admin-card" method="post" action="/admin/settings">
<div class="form-grid">
<label class="field"><span>Store Name</span><input value="LLP" disabled></label><label class="field"><span>Tagline</span><input name="store_tagline" value="<%= s.store_tagline %>"></label>
<label class="field"><span>Currency</span><input name="currency" value="<%= s.currency %>"></label><label class="field"><span>Contact Phone</span><input name="contact_phone" value="<%= s.contact_phone %>"></label>
<label class="field"><span>Contact Email</span><input name="contact_email" value="<%= s.contact_email %>"></label><label class="field"><span>Opening Hours</span><input name="opening_hours" value="<%= s.opening_hours %>"></label>
<label class="field full"><span>Delivery Information</span><input name="delivery_time" value="<%= s.delivery_time %>"></label>
<label class="field full"><span>About Store — Public About Section</span><textarea name="store_info" placeholder="এখানে আপনার নিজের store সম্পর্কে বিস্তারিত লিখুন..."><%= s.store_info %></textarea></label>
</div>
<div class="admin-card" style="margin-top:22px"><h2>Social Media Links</h2><p style="color:#777">Admin এখানে link save করলে public website-এর premium social icon-এ click করলে সেই link-এ যাবে।</p><div class="form-grid"><label class="field"><span>WhatsApp Link</span><input name="whatsapp_link" value="<%= s.whatsapp_link || '' %>" placeholder="https://wa.me/..."></label><label class="field"><span>Instagram Link</span><input name="instagram_link" value="<%= s.instagram_link || '' %>" placeholder="https://instagram.com/..."></label><label class="field"><span>Facebook Link</span><input name="facebook_link" value="<%= s.facebook_link || '' %>" placeholder="https://facebook.com/..."></label><label class="field"><span>TikTok Link</span><input name="tiktok_link" value="<%= s.tiktok_link || '' %>" placeholder="https://tiktok.com/@..."></label></div></div>
<div class="admin-card" style="margin-top:22px"><h2>Payment & Order</h2><div class="form-grid"><label class="field"><span>bKash Number</span><input name="bkash_number" value="<%= s.bkash_number %>"></label><label class="field"><span>Nagad Number</span><input name="nagad_number" value="<%= s.nagad_number %>"></label><label class="field"><span>Rocket Number</span><input name="rocket_number" value="<%= s.rocket_number %>"></label><label><input type="checkbox" name="cod_enabled" value="1" <%= s.cod_enabled==='1'?'checked':'' %>> Cash on Delivery</label><label class="field full"><span>Payment Note</span><textarea name="payment_note"><%= s.payment_note %></textarea></label><label class="field full"><span>Chat Order Prompt</span><textarea name="chat_order_prompt"><%= s.chat_order_prompt %></textarea></label></div></div>
<button class="btn-gold" style="margin-top:20px">Save All Store Settings</button></form><%- include('_shell_end') %>
