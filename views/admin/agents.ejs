<%- include('_shell_start') %><h1 class="serif" style="font-size:42px">Support Agents</h1><div class="admin-grid"><form class="admin-card" method="post" action="/admin/agents/add"><h2>Add Custom Handler</h2><div class="form-grid"><label class="field full"><span>Name</span><input name="name" required></label><label class="field"><span>WhatsApp</span><input name="whatsapp" placeholder="8801XXXXXXXXX"></label><label class="field"><span>Messenger URL</span><input name="messenger_url"></label></div><button class="btn-gold" style="margin-top:15px">Add Agent</button></form><div class="admin-card"><h2>Active Handlers</h2><% agents.forEach(a=>{%><div style="padding:14px 0;border-bottom:1px solid #eee"><b><%= a.name %></b><div style="font-size:13px;color:#777"><%= a.whatsapp||'No WhatsApp' %></div><div style="margin-top:8px"><form method="post" action="/admin/agents/toggle/<%= a.id %>" style="display:inline"><button class="btn-dark" style="padding:7px 10px"><%= Number(a.active)?'Disable':'Enable' %></button></form><form method="post" action="/admin/agents/delete/<%= a.id %>" style="display:inline" onsubmit="return confirm('Delete agent?')"><button class="btn-dark" style="padding:7px 10px">Delete</button></form></div></div><%})%></div></div><%- include('_shell_end') %>
