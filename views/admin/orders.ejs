<%- include('_shell_start') %><h1 class="serif" style="font-size:42px">Orders</h1><div class="admin-card"><div class="table-wrap"><table class="table"><tr><th>Order</th><th>Customer</th><th>Phone</th><th>Total</th><th>Payment</th><th>Status</th></tr><% orders.forEach(o=>{%><tr><td><b><%= o.order_id %></b><br><small><%= o.created_at %></small></td><td><%= o.customer_name %><br><small><%= o.address %></small></td><td><%= o.phone %></td><td>৳<%= Number(o.total).toLocaleString('en-BD') %></td><td><%= o.payment_method %><br><small><%= o.trx_id %></small></td><td><form method="post" action="/admin/orders/status/<%= o.id %>"><select name="status" onchange="this.form.submit()"><% ['Pending','Processing','Shipped','Completed','Cancelled'].forEach(s=>{%><option <%= o.status===s?'selected':'' %>><%= s %></option><%})%></select></form></td></tr><%})%></table></div></div><%- include('_shell_end') %>
