<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LLP Admin Login</title><link rel="stylesheet" href="/css/style.css"></head><body class="login-page"><form class="login-card" method="post" action="/admin/login"><img class="login-logo" src="/assets/llp-logo-circle.png"><div style="text-align:center"><div class="gold" style="font-weight:900;letter-spacing:3px">LLP</div><h1 class="serif" style="font-size:32px;margin:4px 0">Admin Access</h1><p style="color:#777">Long Life Products</p></div><% if(error){%><div class="notice" style="background:#fff0ef;border-color:#e9b4ae"><%= error %></div><%}%><label class="field"><span>Username</span><input name="username" value="admin" required></label><label class="field" style="margin-top:14px"><span>Password</span><input name="password" type="password" required></label><button class="btn-gold" style="width:100%;margin-top:20px">Login</button></form></body></html>
