<%- include('_shell_start') %><h1 class="serif" style="font-size:42px">Edit Product</h1><form class="admin-card" method="post" action="/admin/products/edit/<%= product.id %>" enctype="multipart/form-data"><div class="form-grid"><label class="field full"><span>Name</span><input name="name" value="<%= product.name %>" required></label><label class="field"><span>Category</span><input name="category" value="<%= product.category %>"></label><label class="field"><span>Price</span><input name="price" type="number" step="0.01" value="<%= product.price %>"></label><label class="field"><span>Old Price</span><input name="old_price" type="number" step="0.01" value="<%= product.old_price %>"></label><label class="field full"><span>Replace Image (optional)</span><input name="image" type="file" accept="image/*"></label><label class="field full"><span>Description</span><textarea name="description"><%= product.description %></textarea></label><label><input type="checkbox" name="is_featured" <%= Number(product.is_featured)?'checked':'' %>> Featured</label></div><button class="btn-gold" style="margin-top:18px">Save Changes</button></form><%- include('_shell_end') %>
