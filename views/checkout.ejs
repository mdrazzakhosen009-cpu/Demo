<%- include('partials/header') %><section class="section"><div class="container"><h1 class="serif" style="font-size:48px">Checkout</h1><div class="admin-grid"><form action="/order/place" method="post" class="admin-card"><div class="form-grid"><label class="field"><span>Name</span><input name="customer_name" required></label><label class="field"><span>Mobile</span><input name="phone" required></label><label class="field full"><span>Delivery Address</span><textarea name="address" required></textarea></label><label class="field"><span>Payment</span><select name="payment_method" onchange="document.getElementById('trx').style.display=this.value==='COD'?'none':'block'"><option value="COD">Cash on Delivery</option><option>bKash</option><option>Nagad</option><option>Rocket</option></select></label><label id="trx" class="field" style="display:none"><span>Transaction ID</span><input name="trx_id"></label></div><button class="btn-gold" style="width:100%;margin-top:18px">Place Order</button></form><div class="admin-card"><h3>Order Summary</h3><% cart.forEach(i=>{ %><p><%= i.name %> × <%= i.qty %> — <b><%= settings.currency||'৳' %><%= (Number(i.price)*i.qty).toLocaleString('en-BD') %></b></p><%})%><hr><h2>Total: <span class="price"><%= settings.currency||'৳' %><%= total.toLocaleString('en-BD') %></span></h2><p><%= settings.payment_note %></p></div></div></div></section><%- include('partials/footer') %>
