<%- include('partials/header') %><section class="section"><div class="container" style="max-width:760px"><h1 class="serif" style="font-size:48px">Order Tracking</h1><form class="admin-card" method="get" action="/track" style="display:flex;gap:8px"><input name="order_id" value="<%= order_id||'' %>" placeholder="LLP-12345678" style="flex:1;padding:13px;border:1px solid #ddd;border-radius:10px"><button class="btn-gold">Track</button></form><% if(success&&order){%><div class="notice">Order successfully received. Please save your Order ID.</div><%}%><% if(order){%><div class="admin-card"><span class="pill"><%= order.status %></span><h2><%= order.order_id %></h2><p>Customer: <%= order.customer_name||order.name %></p><p>Total: <b class="price"><%= settings.currency||'৳' %><%= Number(order.total).toLocaleString('en-BD') %></b></p><p>Payment: <%= order.payment_method||order.payment %></p><p>Created: <%= order.created_at||'' %></p></div><%}else if(order_id){%><div class="empty">Order not found. Please check the Order ID.</div><%}%></div></section><%- include('partials/footer') %>
