<button class="chat-launch premium-agent-launch" onclick="openChat()" aria-label="Open LLP Shopping Agent"><span>✦</span><small>Chat with me<br><b>24/7</b></small></button>
<div id="chat-box" class="chat-box"><div class="chat-head"><div class="chat-head-left"><img src="/assets/llp-logo-circle.png"><div><b>LLP Shopping Agent</b><small><span class="online-dot"></span> Online</small></div></div><button onclick="closeChat()">×</button></div><div id="chat-messages" class="chat-msgs"><div class="bubble bot">Hello! 👋<br>I'm your LLP shopping assistant. I can help you find products, answer questions, place orders and track your delivery.</div></div><div class="quick"><button onclick="askAgent('Product দেখাও')">Show Products</button><button onclick="askAgent('Recommend করো')">Best Recommendation</button><button onclick="askAgent('Delivery কতদিন?')">Delivery Info</button><button onclick="askAgent('Order করতে চাই')">Order</button><button onclick="askAgent('আমার order track করতে চাই')">Track Order</button><button onclick="askAgent('Payment information দাও')">Payment Methods</button></div><div class="chat-input"><input id="chat-input" placeholder="Type your message..." onkeydown="if(event.key==='Enter')sendChat()"><button class="send-chat" onclick="sendChat()">➤</button></div></div>
<script>
function openChat(){document.getElementById('chat-box').classList.add('open');document.getElementById('chat-input').focus()}function closeChat(){document.getElementById('chat-box').classList.remove('open')}
function safe(t){const d=document.createElement('div');d.textContent=String(t??'');return d.innerHTML}
function addBubble(cls,text){const box=document.getElementById('chat-messages');const d=document.createElement('div');d.className='bubble '+cls;d.innerHTML=text;box.appendChild(d);box.scrollTop=box.scrollHeight;return d}
function productHtml(ps){if(!Array.isArray(ps)||!ps.length)return '';return '<div class="chat-products">'+ps.map(p=>`<a href="/product/${encodeURIComponent(p.id)}"><img src="${safe(p.image)}"><span><b>${safe(p.name)}</b><small>${safe(p.category||'Product')} · ৳${Number(p.price||0).toLocaleString('en-BD')}</small></span></a>`).join('')+'</div>'}
function agentMarkup(data){let html=data.reply||data.message||'';if(data.products)html+=productHtml(data.products);if(data.agents?.length)html+='<div class="chat-agent-list">'+data.agents.map(a=>`<div><b>${safe(a.name)}</b>${a.whatsapp?`<br><a href="https://wa.me/${safe(a.whatsapp.replace(/\D/g,''))}" target="_blank">WhatsApp</a>`:''}${a.messenger_url?` · <a href="${safe(a.messenger_url)}" target="_blank">Messenger</a>`:''}</div>`).join('')+'</div>';return html}
async function askAgent(msg){openChat();addBubble('user',safe(msg));const wait=addBubble('bot','Thinking…');try{const r=await fetch('/api/agent/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:msg})});const data=await r.json();wait.remove();if(!r.ok||!data.success)throw new Error();addBubble('bot',agentMarkup(data))}catch(e){wait.remove();addBubble('bot','দুঃখিত, এখন agent response দিতে পারছে না। আবার চেষ্টা করুন।')}}
function sendChat(){const i=document.getElementById('chat-input'),v=i.value.trim();if(!v)return;i.value='';askAgent(v)}
</script>
