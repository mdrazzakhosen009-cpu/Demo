<%- include('_shell_start') %><h1 class="serif" style="font-size:42px">Dashboard</h1><p style="color:#777">Live store overview from Turso.</p><div class="stat-grid"><div class="stat"><span>Total Revenue</span><div class="n">৳<%= revenue.toLocaleString('en-BD') %></div></div><div class="stat"><span>Total Orders</span><div class="n"><%= ordersCount %></div></div><div class="stat"><span>Total Products</span><div class="n"><%= productsCount %></div></div></div><div class="admin-card"><h2>Recent Orders</h2><div class="table-wrap"><table class="table"><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th></tr><% recentOrders.forEach(o=>{%><tr><td><%= o.order_id %></td><td><%= o.customer_name %></td><td>৳<%= Number(o.total).toLocaleString('en-BD') %></td><td><span class="pill"><%= o.status %></span></td></tr><%})%></table></div></div><%- include('_shell_end') %>
