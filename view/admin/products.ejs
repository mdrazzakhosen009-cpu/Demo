<%- include('_shell_start') %><h1 class="serif" style="font-size:42px">Products</h1><div class="admin-grid"><form class="admin-card" method="post" action="/admin/products/add" enctype="multipart/form-data"><h2>Add Product</h2><div class="form-grid"><label class="field full"><span>Name</span><input name="name" required></label><label class="field"><span>Category</span><input name="category" value="Wellness"></label><label class="field"><span>Price</span><input name="price" type="number" step="0.01"></label><label class="field"><span>Old Price</span><input name="old_price" type="number" step="0.01"></label><label class="field full"><span>Image</span><input name="image" type="file" accept="image/*"></label><label class="field full"><span>Description</span><textarea name="description"></textarea></label><label><input type="checkbox" name="is_featured"> Featured</label></div><button class="btn-gold" style="margin-top:15px">Add Product</button></form><div class="admin-card"><h2>Live Catalog</h2><div class="table-wrap"><table class="table"><tr><th>Image</th><th>Name</th><th>Price</th><th>Actions</th></tr><% products.forEach(p=>{%><tr><td><img class="mini-img" src="<%= p.image %>"></td><td><b><%= p.name %></b><br><small><%= p.category %></small></td><td>৳<%= Number(p.price).toLocaleString('en-BD') %></td><td><a class="btn-dark" style="text-decoration:none;padding:7px 10px" href="/admin/products/edit/<%= p.id %>">Edit</a><form method="post" action="/admin/products/delete/<%= p.id %>" style="display:inline" onsubmit="return confirm('Delete product?')"><button class="btn-dark" style="padding:7px 10px">Delete</button></form></td></tr><%})%></table></div></div></div><%- include('_shell_end') %>
