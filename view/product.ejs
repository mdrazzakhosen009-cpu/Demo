<%- include('partials/header') %><section class="section"><div class="container"><div style="display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:start"><div><img src="<%= product.image %>" style="width:100%;aspect-ratio:1;object-fit:cover;border-radius:22px;border:1px solid #dfd2bb"><% let gallery=[]; try{gallery=JSON.parse(product.gallery_json||'[]')}catch(e){} %><% if(gallery.length){%><div class="creative-strip" style="margin-top:14px"><% gallery.forEach(g=>{ %><img src="<%= g %>" alt="LLP creative"></img><%}) %></div><%}%></div><div><span class="pill"><%= product.category %></span><h1 class="serif" style="font-size:48px;line-height:1.05"><%= product.name %></h1><div class="price" style="font-size:30px"><%= settings.currency || '৳' %><%= Number(product.price).toLocaleString('en-BD') %></div><% if(Number(product.old_price)>Number(product.price)){%><div class="old" style="font-size:16px"><%= settings.currency || '৳' %><%= Number(product.old_price).toLocaleString('en-BD') %></div><%}%><p style="line-height:1.8;color:#555;margin:25px 0"><%= product.description %></p><form action="/cart/add" method="post"><input type="hidden" name="id" value="<%= product.id %>"><button class="btn-gold" style="width:100%;font-size:16px">Add to Bag</button></form><button class="btn-dark" onclick="openChat();setTimeout(()=>document.getElementById('chat-input').focus(),150)" style="width:100%;margin-top:10px">Ask LLP Assistant</button><div class="admin-card" style="margin-top:20px"><b>Delivery</b><p><%= settings.delivery_time %></p><b>Support</b><p><%= settings.contact_phone %></p></div></div></div></div></section><%- include('partials/footer') %>
