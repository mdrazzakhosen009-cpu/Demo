<%- include('partials/header') %><section class="section"><div class="container"><div style="display:flex;justify-content:space-between;align-items:end;gap:15px;flex-wrap:wrap"><div><span class="gold">LLP COLLECTION</span><h1 class="serif" style="font-size:48px;margin:6px 0">Shop</h1></div><form style="display:flex;gap:8px;flex-wrap:wrap"><input name="search" value="<%= search %>" placeholder="Search products" style="padding:11px;border:1px solid #d8ccb6;border-radius:10px"><select name="category" style="padding:11px;border:1px solid #d8ccb6;border-radius:10px"><option>All</option><% categories.forEach(c=>{ %><option <%= currentCategory===c.category?'selected':'' %>><%= c.category %></option><%}) %></select><button class="btn-gold">Search</button></form></div><div class="product-grid" style="margin-top:30px"><% if(products.length){products.forEach(p=>{ %><article class="card"><a href="/product/<%= p.id %>"><img class="card-img" src="<%= p.image %>" alt="<%= p.name %>"></a><div class="card-body"><span class="pill"><%= p.category %></span><h3><%= p.name %></h3><div><span class="price"><%= settings.currency || '৳' %><%= Number(p.price).toLocaleString('en-BD') %></span> <% if(Number(p.old_price)>Number(p.price)){%><span class="old"><%= settings.currency || '৳' %><%= Number(p.old_price).toLocaleString('en-BD') %></span><%}%></div><a href="/product/<%= p.id %>" class="btn-gold" style="display:inline-block;margin-top:12px;text-decoration:none">View & Order</a></div></article><%})}else{%><div class="empty" style="grid-column:1/-1">No matching products found.</div><%}%></div></div></section><%- include('partials/footer') %>
