<%- include('partials/header') %><section class="section"><div class="container"><h1 class="serif" style="font-size:48px">Shopping Bag</h1><% if(!cart.length){%><div class="empty">Your bag is empty.<br><a href="/shop" style="color:#8c6424">Continue shopping →</a></div><%}else{%><div class="admin-card"><% let total=0; cart.forEach(i=>{total+=Number(i.price)*i.qty;%><div style="display:grid;grid-template-columns:80px 1fr auto;gap:16px;align-items:center;border-bottom:1px solid #eee;padding:14px 0"><img src="<%= i.image %>" class="mini-img"><div><b><%= i.name %></b><div class="price"><%= settings.currency||'৳' %><%= Number(i.price).toLocaleString('en-BD') %></div></div><form action="/cart/update" method="post"><input type="hidden" name="id" value="<%= i.id %>"><input name="qty" type="number" min="0" value="<%= i.qty %>" style="width:70px;padding:9px;border:1px solid #ddd;border-radius:8px"><button class="btn-dark" style="padding:8px 10px">Update</button></form></div><%})%><div style="text-align:right;padding-top:20px"><h2>Total: <span class="price"><%= settings.currency||'৳' %><%= total.toLocaleString('en-BD') %></span></h2><a class="btn-gold" href="/checkout" style="display:inline-block;text-decoration:none">Proceed to Checkout →</a></div></div><%}%></div></section><%- include('partials/footer') %>
